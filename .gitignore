# Secrets
.env
.env.*

# Infrastructure
# The sandbox provisions to $XDG_STATE_HOME/aitk/sandbox now. This covers a tree
# left by an older checkout or by an AITK_SANDBOX_DIR pointed back inside.
.sandbox/

# Dependencies
node_modules/

# Claude
# .records.git holds the backup history for the folders below, not a record itself.
.claude/.records.git/
# README.md is the records repository's landing page, written back by records pull.
.claude/README.md
.claude/.tmp
.claude/diagrams/
.claude/groundwork/
.claude/intake/
.claude/memory/
.claude/plans/
.claude/proposals/
.claude/review/
.claude/worktrees/
.claude/tasks/

# Teaching workspace
.claude/teach/
