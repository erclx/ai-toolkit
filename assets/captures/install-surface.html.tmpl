<!doctype html>
<!--
  Generated by scripts/core/regen-hero.sh from assets/captures/install-surface.html.tmpl.
  Do not edit this file. The token block below is filled from
  `canon design css --no-components`, so a value moved in src/design/tokens.ts
  moves this frame and `bun run check` fails on the difference.

  Source for install-surface.png. Every stack row, count, and standard
  row is filled from `canon tooling list --json` and `canon standards list --json`
  at build time rather than typed. Nothing here is hand-maintained except the two
  command lines and the frame chrome.

  What this frame is for: the repository's two delivery paths are the decision
  the architecture turns on, and no surface shows them side by side. A tooling
  config is copied into a project and owned by it. A standard is never copied and
  is opened by name through a verb. Putting both under one frame is the only way
  a reader sees that the second column is a path in one half and a command in the
  other.

  The standards column samples the catalog evenly rather than taking its first
  rows, matching the hero and the governance frame, since an alphabetical head
  would show a run of names sharing one prefix and read as a narrower corpus than
  the one that ships.
-->
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="{{FAVICON}}" />
    <style>
{{TOKENS}}

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: transparent;
        padding: 28px;
        font-family: 'Noto Sans Mono', 'DejaVu Sans Mono', monospace;
      }
      .window {
        width: 880px;
        background: var(--color-background);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
      }
      .titlebar {
        height: 34px;
        background: var(--color-chrome);
        display: flex;
        align-items: center;
        padding: 0 14px;
        gap: 8px;
      }
      .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
      }

      /* The three dots imitate somebody else's window chrome rather than
         speaking this system's palette, so they stay literal, exactly as
         install.html.tmpl states for the same three. */
      .red {
        background: #ec6a5e;
      }
      .yellow {
        background: #f4bf50;
      }
      .green {
        background: #61c454;
      }
      .title {
        flex: 1;
        text-align: center;
        color: var(--color-muted);
        font-size: 12px;
        letter-spacing: 0.02em;
        margin-right: 46px;
      }
      pre {
        padding: 20px 22px 24px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--color-text-body);
        white-space: pre;
      }
      .prompt {
        color: var(--color-accent);
      }
      .cmd {
        color: var(--color-text);
        font-weight: 600;
      }
      .muted {
        color: var(--color-muted);
      }
      .ok {
        color: var(--color-success);
      }

      /* The border role is tuned for a rule drawn against a panel and reads as
         almost nothing at this size, so the frame glyphs take the muted role
         instead. They are structure a reader follows down the left edge rather
         than an edge between two surfaces. */
      .frame {
        color: var(--color-muted);
      }
      .name {
        color: var(--color-text);
      }
      .blank {
        display: block;
        height: 0.62em;
      }
    </style>
  </head>
  <body>
    <div class="window">
      <div class="titlebar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="title">what installs, and what never does</span>
      </div>
      <pre><span class="prompt">$</span> <span class="cmd">canon tooling list</span>
<span class="frame">├</span> Stacks <span class="muted">({{TOOLING_STACK_COUNT}}, copied into your project and owned by it)</span>
{{TOOLING_STACK_ROWS}}
<span class="blank"></span>
<span class="prompt">$</span> <span class="cmd">canon standards list</span>
<span class="frame">├</span> Standards <span class="muted">({{STANDARD_COUNT}}, never copied, opened by name when a session needs one)</span>
{{STANDARD_ROWS}}
<span class="frame">│</span> <span class="muted">+{{STANDARD_MORE}} more</span>
<span class="frame">└</span></pre>
    </div>
  </body>
</html>
