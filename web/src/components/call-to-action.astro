---
import { callToAction } from '../content/copy'
---

<section
  data-reveal
  id="start"
  class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-6 py-24 text-center"
>
  <h2>{callToAction.heading}</h2>
  <p>{callToAction.body}</p>
  <div class="flex gap-4">
    <a href={callToAction.primary.href} class="btn btn-primary">
      {callToAction.primary.label}
    </a>
    <a href={callToAction.secondary.href} class="btn btn-secondary">
      {callToAction.secondary.label}
    </a>
  </div>
</section>
