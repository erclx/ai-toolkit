---
import { callToAction } from '../content/copy'
---

<section
  data-reveal
  id="start"
  class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-6 py-24 text-center"
>
  <h2 class="text-[length:var(--type-heading-size)]">{callToAction.heading}</h2>
  <p>{callToAction.body}</p>
  <div class="flex gap-4">
    <a
      href={callToAction.primary.href}
      class="rounded-[var(--radius-action)] bg-(--color-accent) px-6 py-3 font-medium text-(--color-background) no-underline"
    >
      {callToAction.primary.label}
    </a>
    <a
      href={callToAction.secondary.href}
      class="rounded-[var(--radius-action)] border border-(--color-border) px-6 py-3 font-medium text-(--color-text) no-underline"
    >
      {callToAction.secondary.label}
    </a>
  </div>
</section>
