---
import { teachPreview } from '../content/copy'
import Panel from './panel.astro'

/**
 * A live embed of one lesson from `.canon/teach/04-governance-rule-loading/`,
 * the workspace `scripts/core/regen-web-previews.ts` renders in isolation and
 * writes to `web/public/previews/teach-workspace/`. Isolated rather than
 * copied straight out of `.canon/teach/`, since that folder cross-links every
 * sibling workspace by relative path, including the operator's own personal
 * study notes never meant to be public.
 */
---

<section
  data-reveal
  id="teach-preview"
  class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
>
  <h2>{teachPreview.heading}</h2>
  <p>{teachPreview.lede}</p>

  <Panel foot={teachPreview.citation}>
    <iframe
      src="/previews/teach-workspace/04-governance-rule-loading/lessons/0001-rule-arrival.html"
      title="Teach workspace lesson preview"
      loading="lazy"
      class="h-[640px] w-full rounded-[var(--radius-panel)] border border-(--color-border)"
    ></iframe>
  </Panel>
</section>
