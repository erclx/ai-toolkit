---
import { install } from '../content/copy'
import Panel from './panel.astro'

/**
 * Replaced `install.png`, which was the one committed frame genuinely short of
 * pixels: it supplied 0.90 physical pixels for every one a retina display
 * asked for, against 1.04 for the other four. Commands are also the thing a
 * reader most wants to select and copy, which a raster cannot offer.
 */
---

<section
  data-reveal
  id="install"
  class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
>
  <h2 class="text-[length:var(--type-heading-size)]">{install.heading}</h2>
  <p>{install.lede}</p>

  <Panel foot={install.note}>
    {
      install.commands.map((command) => (
        <div class="flex gap-3 py-0.5">
          <span aria-hidden="true" class="text-(--color-accent)">
            $
          </span>
          <code class="text-(--color-text)">{command}</code>
        </div>
      ))
    }
  </Panel>

  <p>{install.cliNote}</p>

  <Panel>
    <div class="flex gap-3">
      <span aria-hidden="true" class="text-(--color-accent)">$</span>
      <code class="text-(--color-text)">{install.cliCommand}</code>
    </div>
  </Panel>
</section>
