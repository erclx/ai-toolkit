---
import { catalog } from '../content/copy'
import { readCatalogCounts } from '../lib/counts'
import { loadsWhen, readRuleGroups } from '../lib/catalogs'
import Panel from './panel.astro'
import PanelGroup from './panel-group.astro'
import PanelRow from './panel-row.astro'

/**
 * The counts, then the rules those counts are over.
 *
 * The rules half is the treatment picked on 2026-09-07 across two rounds. Its
 * point is that the group structure is complete at every domain while the rows
 * inside each are the sample: a flat sample of ten rules renders five of the
 * eight domains and gives the reader no way to know the other three exist, so
 * the corpus reads smaller than it is.
 *
 * This replaced `hero.png`, which carried the same catalogs as a raster.
 */
const counts = readCatalogCounts()
const { groups, total, domains } = readRuleGroups()
---

<section
  data-reveal
  id="catalog"
  class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
>
  <h2>{catalog.heading}</h2>

  <Panel foot={catalog.countNote}>
    <dl data-catalog-counts class="m-0 grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        (Object.entries(counts) as [string, number][]).map(([name, value]) => (
          <div>
            <dd class="m-0 text-[length:var(--type-display-size)] leading-[var(--type-display-lh)] font-bold text-(--color-text)">
              {value}
            </dd>
            <dt class="text-[length:var(--type-label-size)] tracking-[0.05em] text-(--color-text-secondary)">
              {name}
            </dt>
          </div>
        ))
      }
    </dl>
  </Panel>

  <p>{catalog.rulesLede}</p>

  <Panel columns foot={catalog.rulesProvenance(total, domains)}>
    {
      groups.map((group) => (
        <PanelGroup
          label={group.domain}
          total={group.total}
          shown={group.sample.length}
        >
          {group.sample.map((rule) => {
            const loads = loadsWhen(rule)
            return (
              <PanelRow
                name={rule.name}
                value={loads.label}
                scoped={loads.scoped}
              />
            )
          })}
        </PanelGroup>
      ))
    }
  </Panel>

  {
    /* Six domains, each a term and what it is. A flat run of paragraphs read as
      a wall, so the name is split out and carries the weight. */
  }
  <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
    {
      catalog.items.map((item) => {
        const [term, ...rest] = item.split(': ')
        return (
          <div>
            <dt class="font-semibold text-(--color-text)">{term}</dt>
            <dd class="m-0 text-(--color-text-secondary)">{rest.join(': ')}</dd>
          </div>
        )
      })
    }
  </dl>
</section>
