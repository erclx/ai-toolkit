---
import { readCatalogCounts } from '../lib/counts'
import { catalog } from '../content/copy'

const counts = readCatalogCounts()
---

<section class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24">
  <h2 class="text-[length:var(--type-heading-size)]">{catalog.heading}</h2>
  <img
    src={catalog.image.src}
    alt={catalog.image.alt}
    class="w-full rounded-[var(--radius-frame)] border border-(--color-border)"
    loading="lazy"
  />
  <p class="text-(--color-text-secondary)">{catalog.countNote}</p>
  <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      (Object.entries(counts) as [string, number][]).map(([name, value]) => (
        <div class="rounded-[var(--radius-panel)] bg-(--color-surface) p-4">
          <dt class="text-[length:var(--type-label-size)] tracking-[0.05em] text-(--color-text-secondary) uppercase">
            {name}
          </dt>
          <dd class="m-0 text-[length:var(--type-heading-size)] font-semibold text-(--color-text)">
            {value}
          </dd>
        </div>
      ))
    }
  </dl>
  <ul class="flex flex-col gap-3">
    {catalog.items.map((item) => <li>{item}</li>)}
  </ul>
</section>
