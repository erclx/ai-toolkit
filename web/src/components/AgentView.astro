---
import { agentView } from '../content/copy'
import fixture from '../fixtures/agent-view.json'

/**
 * A re-creation of Claude Code's own session list rather than a diagram of one.
 * The layout is what that surface renders: two bands visible at once, a dense
 * row per session carrying a marker, a name, its activity, its pull request and
 * its age, and a remainder line for everything past the end.
 *
 * Both bands showing at once is the part a swapping label got wrong. Working
 * and Completed are places a row sits, so a session finishing moves between
 * them, and a label flipping in place described neither.
 *
 * The rows come from `web/src/fixtures/agent-view.json`, written by
 * `scripts/core/regen-agent-fixture.sh` off a real session listing. The
 * provenance line below is rendered rather than commented, because a claim this
 * section makes about itself is the reader's only way to tell a re-creation
 * from a mockup.
 *
 * The working marker is the glyph Claude Code shows, confirmed against the
 * vendor page. Its frame sequence is undocumented, so the cycle below is chosen
 * rather than reproduced, and nothing re-checks it against a later release.
 */

const readOn = new Date(fixture.readAt).toISOString().slice(0, 10)

const working = fixture.sessions.filter((s) => s.state === 'working')
const completed = fixture.sessions.filter((s) => s.state === 'completed')

/*
 * The first working row is the one that lands while the reader watches. It
 * renders in both bands with one side collapsed, because moving a node across a
 * heading is not something CSS can transition, and a reader cannot tell a node
 * that moved from one that gave way to its twin.
 */
const mover = working[0]
const stayers = working.slice(1)
---

<section
  class="agent-view mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
  id="agent-view"
>
  <h2 class="text-[length:var(--type-heading-size)]">{agentView.heading}</h2>
  <p>{agentView.body}</p>

  <div
    class="agent-stage rounded-[var(--radius-panel)] bg-(--color-surface) p-5 text-[length:var(--type-label-size)] leading-[1.9]"
  >
    {
      /*
      The count moves with the row. Leaving one line to stand while a row
      crosses beneath it puts a number on screen that the list under it
      contradicts, which is the one thing a counted surface must not do.
    */
    }
    <p
      class="agent-summary agent-summary-before m-0 text-(--color-text-secondary)"
    >
      <span class="count-working">{fixture.summary.working}</span> working
      <span aria-hidden="true"> · </span>
      <span class="count-completed">{fixture.summary.completed}</span> completed
    </p>
    <p
      class="agent-summary agent-summary-after m-0 text-(--color-text-secondary)"
    >
      <span>{fixture.summary.working - 1}</span> working
      <span aria-hidden="true"> · </span>
      <span>{fixture.summary.completed + 1}</span> completed
    </p>

    <p class="agent-band m-0 mt-4">{agentView.bands.working}</p>
    <ol class="m-0 flex list-none flex-col p-0">
      <li class="agent-row agent-row-mover" data-branch={mover.branch}>
        <span class="marker marker-working" aria-hidden="true">✽</span>
        <span class="agent-name">{mover.name}</span>
        <span class="agent-activity">{mover.activity}</span>
        <span class="agent-pr">
          {mover.pullRequest && `#${mover.pullRequest}`}
        </span>
        <span class="agent-age">{mover.age}</span>
      </li>
      {
        stayers.map((session) => (
          <li class="agent-row" data-branch={session.branch}>
            <span class="marker marker-working" aria-hidden="true">
              ✽
            </span>
            <span class="agent-name">{session.name}</span>
            <span class="agent-activity">{session.activity}</span>
            <span class="agent-pr">
              {session.pullRequest && `#${session.pullRequest}`}
            </span>
            <span class="agent-age">{session.age}</span>
          </li>
        ))
      }
    </ol>

    <p class="agent-band m-0 mt-4">{agentView.bands.completed}</p>
    <ol class="m-0 flex list-none flex-col p-0">
      <li class="agent-row agent-row-landed" data-branch={mover.branch}>
        <span class="marker marker-done" aria-hidden="true">✽</span>
        <span class="agent-name">{mover.name}</span>
        <span class="agent-activity">{agentView.landed}</span>
        <span class="agent-pr">
          {mover.pullRequest && `#${mover.pullRequest}`}
        </span>
        <span class="agent-age">{mover.age}</span>
      </li>
      {
        completed.map((session) => (
          <li class="agent-row" data-branch={session.branch}>
            <span class="marker marker-done" aria-hidden="true">
              ✽
            </span>
            <span class="agent-name">{session.name}</span>
            <span class="agent-activity">{session.activity}</span>
            <span class="agent-pr">
              {session.pullRequest && `#${session.pullRequest}`}
            </span>
            <span class="agent-age">{session.age}</span>
          </li>
        ))
      }
    </ol>

    <p class="agent-more m-0 mt-1 text-(--color-muted)">
      … {fixture.summary.more} more
    </p>
  </div>

  <p class="text-[length:var(--type-label-size)] text-(--color-text-secondary)">
    {agentView.provenance.live}{' '}
    <time datetime={readOn}>{readOn}</time>. {agentView.provenance.transcribed}
  </p>
</section>

<style>
  .agent-stage {
    overflow-x: auto;
    font-family: var(--type-code-family);
  }

  .agent-row {
    display: grid;
    grid-template-columns: 1.2rem minmax(16rem, auto) 1fr auto 2.5rem;
    gap: 0 0.75rem;
    align-items: baseline;
    white-space: nowrap;
  }

  .agent-name {
    color: var(--color-text);
  }

  .agent-activity {
    overflow: hidden;
    color: var(--color-text-body);
    text-overflow: ellipsis;
  }

  .agent-pr {
    color: var(--color-text-secondary);
  }

  .agent-age {
    color: var(--color-muted);
    text-align: right;
  }

  .agent-band {
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
  }

  .agent-summary-after {
    display: none;
  }

  .agent-stage.is-complete .agent-summary-before {
    display: none;
  }

  .agent-stage.is-complete .agent-summary-after {
    display: block;
  }

  /*
   * Two animations, which is what takes the page to three in total. A fourth is
   * what `internal/rules/claude/593-landing-page.md` refuses, so a later section
   * animating anything replaces one of these rather than joining them.
   */
  .marker-working {
    display: inline-block;
    color: var(--color-accent);
    animation: marker-cycle 1s steps(1, end) infinite;
  }

  .marker-done {
    color: var(--color-success);
  }

  @keyframes marker-cycle {
    0% {
      transform: rotate(0deg);
    }
    33% {
      transform: rotate(30deg);
    }
    66% {
      transform: rotate(60deg);
    }
    100% {
      transform: rotate(90deg);
    }
  }

  /*
   * The landed copy is what the row becomes, so it starts collapsed while the
   * working copy starts open. A row slide needs a measurable box to animate,
   * which is what the max-height carries.
   */
  .agent-row-mover,
  .agent-row-landed {
    overflow: hidden;
    transition:
      max-height 0.45s ease,
      opacity 0.45s ease;
  }

  .agent-row-mover {
    max-height: 2rem;
    opacity: 1;
  }

  .agent-row-landed {
    max-height: 0;
    opacity: 0;
  }

  .agent-stage.is-complete .agent-row-mover {
    max-height: 0;
    opacity: 0;
  }

  .agent-stage.is-complete .agent-row-landed {
    max-height: 2rem;
    opacity: 1;
  }

  /*
   * A marker cycling forever is decoration to a reader who asked for less of
   * it, and the move still lands because it is carried by the class rather than
   * by the motion.
   */
  @media (prefers-reduced-motion: reduce) {
    .marker-working {
      animation: none;
    }

    .agent-row-mover,
    .agent-row-landed {
      transition: none;
    }
  }
</style>

<script>
  /*
   * The dwell is the section. Moving the row on the intersection itself put it
   * in Completed in the frame the scroll landed, so a reader arriving saw the
   * finished state and never the one it finished from, which is the whole thing
   * this section shows. A recording proved it: sampled at half-second intervals,
   * no frame carried the row still working.
   *
   * It is sequencing rather than decoration, so it holds under reduced motion
   * too. What that branch drops is the slide, not the reader's chance to read
   * the first state.
   */
  const DWELL_MS = 1600

  const stage = document.querySelector<HTMLElement>('.agent-stage')
  if (stage) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            observer.disconnect()
            window.setTimeout(
              () => stage.classList.add('is-complete'),
              DWELL_MS,
            )
          }
        }
      },
      { threshold: 0.4 },
    )
    observer.observe(stage)
  }
</script>
