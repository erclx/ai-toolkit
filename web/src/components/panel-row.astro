---
/**
 * One row inside a panel: what the thing is called, and the one fact the
 * section turns on.
 *
 * `scoped` decides which of two forms the trailing value takes. A scoped value
 * gets a chip and an unscoped one stays bare, which is the distinction the
 * rules section argues: a glob decides whether a rule loads at all.
 *
 * The chip is deliberately not the accent. An earlier cut drew it in
 * `--color-accent` and the page ended up carrying 21 of them, against a rule
 * in `internal/rules/claude/593-landing-page.md` that caps structural accent
 * at exactly one use. Measured at 5.36:1 against a 3:1 floor, no single chip
 * was too bright; there were simply twenty-one, so the accent stopped being a
 * signal and became the texture of the page. The chip now reads on surface and
 * border tokens, which is what that rule points a section at when it separates
 * a state that is not the live one.
 */
interface Props {
  name: string
  value: string
  scoped?: boolean
}

const { name, value, scoped = false } = Astro.props
---

<div class="flex items-baseline justify-between gap-4 py-px">
  <span class="text-(--color-text)">{name}</span>
  {
    scoped ? (
      <span class="shrink-0 rounded-[var(--radius-pill)] border border-(--color-border) bg-(--color-chrome) px-2.5 text-[length:var(--type-label-size)] text-(--color-text-secondary)">
        {value}
      </span>
    ) : (
      <span class="shrink-0 px-2.5 text-[length:var(--type-label-size)] text-(--color-muted)">
        {value}
      </span>
    )
  }
</div>
