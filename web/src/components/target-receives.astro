---
import { targetReceives } from '../content/copy'
import { readStandards, readToolingStacks } from '../lib/catalogs'
import Panel from './panel.astro'
import PanelGroup from './panel-group.astro'
import PanelRow from './panel-row.astro'

/**
 * Two catalogs side by side, which is the section's whole argument: a stack is
 * copied in and becomes yours, a standard never is. Both are read at build
 * time, so the counts move when the catalogs do.
 *
 * This replaced two committed frames, `install-surface.png` and
 * `governance.png`, which made this the tallest section on the page at 1,628px
 * with nothing in it that moved.
 */
const stacks = readToolingStacks()
const { entries, total: standardsTotal } = readStandards()
const shownStandards = entries.slice(0, 6)
---

<section
  data-reveal
  id="install-surface"
  class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
>
  <h2 class="text-[length:var(--type-heading-size)]">
    {targetReceives.heading}
  </h2>
  <p>{targetReceives.body}</p>

  <Panel foot={targetReceives.provenance}>
    <div class="grid gap-8 sm:grid-cols-2">
      <PanelGroup label="Copied into your project" total={stacks.length}>
        {
          stacks.map((stack) => (
            <PanelRow
              name={stack.name}
              value={`${stack.devDeps} deps · ${stack.scripts} scripts`}
              scoped
            />
          ))
        }
      </PanelGroup>
      <PanelGroup
        label="Never copied"
        total={standardsTotal}
        shown={shownStandards.length}
      >
        {
          shownStandards.map((entry) => (
            <PanelRow
              name={entry.name}
              value={entry.appliesTo?.[0] ?? 'read by name'}
            />
          ))
        }
      </PanelGroup>
    </div>
  </Panel>

  <p>{targetReceives.governance.body}</p>
</section>
