---
import { ruleArrival } from '../content/copy'
---

<section
  data-reveal
  id="rules"
  class="rule-arrival mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
>
  <h2 class="text-[length:var(--type-heading-size)]">{ruleArrival.heading}</h2>
  <p>{ruleArrival.body}</p>
  <div class="rule-arrival-stage grid gap-4 sm:grid-cols-2">
    <div class="rounded-[var(--radius-panel)] bg-(--color-surface) p-4">
      <p
        class="text-[length:var(--type-label-size)] tracking-[0.05em] text-(--color-text-secondary) uppercase"
      >
        Editing
      </p>
      <pre
        class="m-0 overflow-x-auto text-(--color-text)"><code>{ruleArrival.filename}</code></pre>
    </div>
    <div
      class="rule-card rounded-[var(--radius-panel)] border border-(--color-accent) bg-(--color-surface) p-4 opacity-0"
    >
      <p
        class="text-[length:var(--type-label-size)] tracking-[0.05em] text-(--color-text-secondary) uppercase"
      >
        {ruleArrival.rule.glob}
      </p>
      <p class="m-0 font-semibold text-(--color-text)">
        {ruleArrival.rule.title}
      </p>
      <p class="m-0 text-(--color-text-body)">{ruleArrival.rule.excerpt}</p>
      <p
        class="m-0 text-[length:var(--type-label-size)] text-(--color-text-secondary)"
      >
        {ruleArrival.rule.path}
      </p>
    </div>
  </div>
</section>

<style>
  .rule-card {
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    transform: translateY(8px);
  }

  .rule-arrival-stage.is-visible .rule-card {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.rule-arrival-stage')
  if (stage) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            stage.classList.add('is-visible')
            observer.disconnect()
          }
        }
      },
      { threshold: 0.4 },
    )
    observer.observe(stage)
  }
</script>
