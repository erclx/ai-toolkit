#!/usr/bin/env sh

# Archives the task a pull merged, so the board closes without a person naming it.
#
# Every step before the merge fires from a chain and the archive used to fire
# when a person remembered, so shipped tasks accumulated on a board that reads
# as ready to hand a worker. This is the only event that lands after a merge.
#
# The pull request number is the link. `git-pr` writes `Pull request: #NNN` onto
# the task when it opens one, and every merge on `main` is a squash carrying
# that number in its subject, so the number survives a merge where a branch name
# does not. Matching on it is what separates a shipped task from an abandoned
# one, which a blind sweep of every all-`[x]` task cannot do.
#
# The hook extracts the number and nothing else. `canon tasks archive` owns every
# gate, because the skill calls the same command and two callers gating in two
# places drift into archiving differently. Each gate refuses with a non-zero
# exit rather than reporting, since nobody is watching this run.
#
# Husky runs this as `sh -e`, so the shebang is advisory and any bare command
# returning non-zero aborts the hook and prints a husky failure. Keep every
# test inside an `if` condition, which errexit exempts.

root=$(git worktree list --porcelain 2>/dev/null | grep -m 1 '^worktree ' | cut -d' ' -f2-) || root=''
[ -n "$root" ] || exit 0

# The board is shared scratch at the main worktree root, and `git worktree
# list` puts that root first. A pull inside a linked worktree fires this same
# hook, so trusting the working directory would read a board that is not there.
board="$root/.claude/tasks"
[ -d "$board" ] || exit 0

if ! command -v canon >/dev/null 2>&1; then
  exit 0
fi

# Every subject the pull brought in, not just the tip. One pull routinely
# fast-forwards over several merges, and reading HEAD alone would archive the
# last one's task and silently strand the rest. `git pull` sets ORIG_HEAD to the
# pre-merge tip, so the range is exactly what arrived. A merge that leaves no
# ORIG_HEAD falls back to the tip.
if git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1; then
  subjects=$(git log ORIG_HEAD..HEAD --pretty=%s 2>/dev/null) || subjects=''
else
  subjects=$(git log -1 --pretty=%s 2>/dev/null) || subjects=''
fi

# A squash carries `(#NNN)` at the end of the subject. A release or a merge
# naming no pull request yields nothing here, which is what keeps this quiet on
# the runs it has nothing to say about.
numbers=$(printf '%s\n' "$subjects" | sed -n 's/.*(#\([0-9][0-9]*\))[[:space:]]*$/\1/p')

if [ -n "$numbers" ]; then
  printf '%s\n' "$numbers" | while IFS= read -r number; do
    [ -n "$number" ] || continue

    # `--json` keeps the record on stdout parseable and every refusal reason
    # with it. A refusal is ordinary here, since most merges close no task.
    if record=$(canon tasks archive --pull-request "$number" --root "$root" --json 2>/dev/null); then
      task=$(printf '%s' "$record" | sed -n 's/.*"task":"\([^"]*\)".*/\1/p')
      printf '\n📦 Archived %s, closed by #%s.\n\n' "$task" "$number"
      continue
    fi

    reason=$(printf '%s' "$record" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')

    # No task names this pull request, which is what a release or an unlinked
    # branch looks like. Nothing to report.
    if [ "$reason" = "no-match" ] || [ "$reason" = "no-board" ] || [ -z "$reason" ]; then
      continue
    fi

    message=$(printf '%s' "$record" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
    printf '\n📋 Task not archived for #%s: %s\n' "$number" "${message:-$reason}"
    printf 'Run /claude-tasks to resolve it by hand.\n\n'
  done
fi

# The eight gitignored record folders live on one disk and nowhere else, and a
# merge is the event that changes them most. This runs on every merge rather
# than only on one that archived a task, since a review report and a memory
# entry both land on runs that close nothing.
#
# It sits last so a slow or unreachable remote delays no archiving, and inside
# an `if` so a push failing offline still leaves this hook exiting zero.
if backup=$(canon records push --root "$root" --json 2>/dev/null); then
  changed=$(printf '%s' "$backup" | sed -n 's/.*"changed":\([0-9][0-9]*\).*/\1/p')
  if [ -n "$changed" ] && [ "$changed" != "0" ]; then
    printf '\n🗄️  Backed up %s record path(s).\n\n' "$changed"
  fi
else
  reason=$(printf '%s' "$backup" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')

  # No records history on this machine, which is every checkout that never ran
  # the one-time setup. Nothing to report.
  if [ "$reason" != "no-repository" ]; then
    printf '\n🗄️  Records not backed up: %s\n' "${reason:-unknown}"
    printf 'Run canon records push when the remote is reachable.\n\n'
  fi
fi
